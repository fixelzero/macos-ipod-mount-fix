<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.fixel.ipod.automount</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/usr/local/libexec/fixel-ipod/mount_watch.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/fixel-ipod-mount-error.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/fixel-ipod-mount.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
